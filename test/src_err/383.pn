// expect: compiler error: asm input must be an integer constant expression or an address of a global variable at src_err/383.pn:8
// 意味解析エラー: asm文の入力"i"に，グローバルの構造体変数のメンバの値は書けない(番地を表すのはメンバ配列の名前だけである) (異常系)
struct pt {
    int x;
};
struct pt p;
void main(void) {
    asm("mov fh r0 r1 %0" : : "i"(p.x));
}
