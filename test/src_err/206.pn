// 生成エラー: グローバル変数とスタックの合計がメモリの前半(32768バイト)を超える (異常系)
// 呼び出しの段ごとにローカル変数のフレームが積まれるため，深いほどスタックを多く使う
int table[4096];
void f3(void) {
    int buf[2048];
    buf[0] = 0;
}
void f2(void) {
    int buf[1024];
    buf[0] = 0;
    f3();
}
void f1(void) {
    int buf[1024];
    buf[0] = 0;
    f2();
}
void main(void) {
    table[0] = 0;
    f1();
}
