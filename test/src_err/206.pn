// 生成エラー: グローバル変数とスタックの合計がメモリ容量(4096バイト)を超える (異常系)
// 呼び出しの段ごとにローカル変数のフレームが積まれるため，深いほどスタックを多く使う
int table[512];
void f3(void) {
    int buf[256];
    buf[0] = 0;
}
void f2(void) {
    int buf[128];
    buf[0] = 0;
    f3();
}
void f1(void) {
    int buf[128];
    buf[0] = 0;
    f2();
}
void main(void) {
    table[0] = 0;
    f1();
}
