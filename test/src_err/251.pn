// expect: compiler error: global variables (49152 bytes) and stack (19208 bytes) exceed memory capacity (65536 bytes)
// コード生成エラー: 関数ポインタを通した呼び出しは，番地を取得された全関数を呼びうるものとしてスタック使用量を見積もる
// mainから直接呼ばれない関数(big)のフレームも数えるため，グローバル変数との合計がメモリ容量を超える (異常系)
int table[12288];                 // 49152バイト
int big(void) {
    int buf[4800];                // 19200バイト (フレームを大きくする)
    buf[0] = 1;
    return buf[0];
}
void main(void) {
    int (*f)(void) = big;
    table[0] = f();
}
