// expect: compiler error: global variables (24576 bytes) and stack (9608 bytes) exceed first half of memory (32768 bytes)
// コード生成エラー: 関数ポインタを通した呼び出しは，番地を取得された全関数を呼びうるものとしてスタック使用量を見積もる
// mainから直接呼ばれない関数(big)のフレームも数えるため，グローバル変数との合計がメモリの前半を超える (異常系)
int table[6144];                  // 24576バイト
int big(void) {
    int buf[2400];                // 9600バイト (フレームを大きくする)
    buf[0] = 1;
    return buf[0];
}
void main(void) {
    int (*f)(void) = big;
    table[0] = f();
}
