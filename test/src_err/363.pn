// expect: compiler error: asm input must be an integer constant expression, an address of a global variable or a function name at src_err/363.pn:8
// 意味解析エラー: asm文の入力"i"に，ローカルの構造体配列の要素のメンバの番地は書けない (異常系)
struct pt {
    int x;
};
void main(void) {
    struct pt la[2];
    asm("wm fh r0 r1 %0" : : "i"(&la[1].x));
}
