    wmr fh r16 r1 4
    wmr fh r16 r2 8
    wmr fh r16 r3 12
    wmr fh r16 r4 16
    wmr fh r16 r5 20
    syscall
    rmr fh r16 r1 0
    mov fh r0 r6 24
    add r16 r6 r16
    rmr fh r16 r0 8
    add r0 r1 r0
    wm fh r0 r0 688
    mov fh r0 r0 2
    mov fh r0 r1 5
    wmr fh r16 r0 8
    wmr fh r16 r1 12
    mov fh r0 r2 6
