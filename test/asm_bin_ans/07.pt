.global main

main:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    wm fh r0 r0 312
    rmr fh r16 r0 0
    mov fh r0 r1 2
    egt r0 r1 .L0
    mov fh r0 r0 1
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    mov fh r0 r1 5
    mov fh r0 r0 24
    sub r16 r0 r16
    wmr fh r16 r1 4
    wmr fh r16 r30 8
    syscall
.L0:
    mov fh r0 r0 0
    mov fh r0 r1 1
    mov fh r0 r2 2
    sll r1 r2 r1
    rmr fh r16 r2 4
    add r1 r2 r1
    rm fh r1 r1
    add r0 r1 r0
    rm 1h r0 r0
    mov fh r0 r1 24
    sll r0 r1 r0
    sra r0 r1 r0
    wm 1h r0 r0 316
    mov fh r0 r0 8
    add r16 r0 r16
    mov fh r0 r1 5
    mov fh r0 r0 24
    sub r16 r0 r16
    wmr fh r16 r1 4
    wmr fh r16 r30 8
