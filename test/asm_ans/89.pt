.global main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 0
    wmr fh r16 r0 0
    rmr fh r16 r1 0
    mov fh r1 r0
    rm 1h r0 r0
    mov fh r0 r2 24
    sll r0 r2 r0
    sra r0 r2 r0
    mov fh r0 r2 3
    add r0 r2 r0
    wm 1h r1 r0
    mov fh r0 r1 1
    rmr fh r16 r2 0
    add r1 r2 r1
    mov fh r1 r0
    rm 1h r0 r0
    mov fh r0 r2 24
    sll r0 r2 r0
    sra r0 r2 r0
    mov fh r0 r2 4
    or r0 r2 r0
    wm 1h r1 r0
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r1
    wmr fh r16 r1 0
    rm 1h r0 r0
    mov fh r0 r1 24
    sll r0 r1 r0
    sra r0 r1 r0
    wm fh r0 r0 4
    mov fh r0 r0 4
    add r16 r0 r16
    ret
