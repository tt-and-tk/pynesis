.global step, main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 1
    wm fh r0 r0 0
    rm fh r0 r0 0
    wmr fh r16 r0 0
    call step
    mov fh r30 r1
    rmr fh r16 r0 0
    add r0 r1 r0
    wm fh r0 r0 0
    mov fh r0 r0 4
    add r16 r0 r16
    ret

step:
    rm fh r0 r0 0
    mov fh r0 r30
    ret
    ret
