.global f, main

main:
    mov fh r0 r0 16
    sub r16 r0 r16
    mov fh r0 r0 5
    wmr fh r16 r0 0
    mov fh r0 r0 3
    wmr fh r16 r0 4
    mov fh r0 r0 0
    wmr fh r16 r0 8
    rmr fh r16 r0 0
    wmr fh r16 r0 12
    rmr fh r16 r1 4
    wmr fh r16 r1 -8
    call f
    mov fh r30 r1
    rmr fh r16 r0 12
    elt r0 r1 .L0
    mov fh r0 r0 1
    wmr fh r16 r0 8
.L0:
    rmr fh r16 r0 8
    wmr fh r16 r0 12
    rmr fh r16 r1 0
    wmr fh r16 r1 -8
    call f
    mov fh r30 r1
    rmr fh r16 r0 12
    add r0 r1 r0
    wmr fh r16 r0 8
    rmr fh r16 r0 8
    wmr fh r16 r0 12
    rmr fh r16 r1 0
    wmr fh r16 r1 -8
    call f
    mov fh r30 r1
    rmr fh r16 r0 12
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 16
    add r16 r0 r16
    ret

f:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
