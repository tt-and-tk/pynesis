.global big, main

main:
    call big
    mov fh r30 r0
    mov fh r0 r1 2
    divu r0 r1 r0
    wm fh r0 r0 0
    call big
    mov fh r30 r0
    mov fh r0 r1 1
    gtu r0 r1 .L0
    mov fh r0 r0 0
    jmp .L1
.L0:
    mov fh r0 r0 1
.L1:
    wm fh r0 r0 0
    ret

big:
    mov fh r0 r0 FFFFFFFEh
    mov fh r0 r30
    ret
    ret
