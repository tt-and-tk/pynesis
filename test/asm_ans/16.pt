.global add, main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 3
    wmr fh r16 r0 -12
    mov fh r0 r0 5
    wmr fh r16 r0 -8
    call add
    mov fh r30 r0
    wmr fh r16 r0 0
    mov fh r0 r0 4
    add r16 r0 r16
    ret

add:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    ret
    mov fh r0 r0 8
    add r16 r0 r16
    ret
