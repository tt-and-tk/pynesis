.global add, sub, done, apply, main

main:
    mov fh r0 r0 add
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 sub
    mov fh r0 r1 1
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 1
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 8
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 done
    wm fh r0 r0 16
    mov fh r0 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    wmr fh r16 r0 -16
    mov fh r0 r0 3
    wmr fh r16 r0 -12
    mov fh r0 r0 4
    wmr fh r16 r0 -8
    call apply
    mov fh r30 r0
    wm fh r0 r0 20
    mov fh r0 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 8
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 9
    wmr fh r16 r1 -12
    mov fh r0 r1 2
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 24
    rm fh r0 r0 16
    call r0
    ret

add:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    ret
    mov fh r0 r0 8
    add r16 r0 r16
    ret

sub:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    sub r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    ret
    mov fh r0 r0 8
    add r16 r0 r16
    ret

done:
    mov fh r0 r0 1
    wm fh r0 r0 28
    ret

apply:
    mov fh r0 r0 12
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    wmr fh r16 r1 -12
    rmr fh r16 r1 8
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    mov fh r0 r30
    mov fh r0 r0 12
    add r16 r0 r16
    ret
    mov fh r0 r0 12
    add r16 r0 r16
    ret
