.global syscall, sysret, main

main:
    call syscall
    call sysret
    ret

syscall:
    rm fh r0 r0 0
    mov fh r0 r1 0
    eq r0 r1 .L0
    mov fh r16 r0
    mov fh r0 r1 8
    add r0 r1 r0
    mov fh r0 r16
    mov fh r16 r0
    mov fh r0 r1 1
    sub r0 r1 r1
    mov fh r1 r16
    mov fh r16 r0
    mov fh r0 r1 1
    add r0 r1 r0
    mov fh r0 r16
    syscall
.L0:
    ret

sysret:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r16 r0
    wmr fh r16 r0 0
    mov fh r17 r0
    mov fh r21 r1
    add r0 r1 r0
    wm fh r0 r0 0
    mov fh r0 r0 4
    add r16 r0 r16
    ret
