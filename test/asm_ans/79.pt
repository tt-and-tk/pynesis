.global set, main

main:
    mov fh r0 r0 8
    sub r16 r0 r16
    mov fh r0 r0 1
    wmr fh r16 r0 0
    mov fh r0 r0 0
    add r16 r0 r0
    wmr fh r16 r0 4
    mov fh r0 r0 0
    wm fh r0 r0 4
    mov fh r0 r0 5
    rm fh r0 r1 4
    wm fh r1 r0
    rmr fh r16 r0 4
    wmr fh r16 r0 -12
    rm fh r0 r0 4
    rm fh r0 r0
    mov fh r0 r1 1
    add r0 r1 r0
    wmr fh r16 r0 -8
    call set
    rmr fh r16 r0 0
    wm fh r0 r0 8
    mov fh r0 r0 FFFFFFFFh
    wmr fh r16 r0 4
    rmr fh r16 r0 4
    mov fh r0 r1 FFFFFFFFh
    ne r0 r1 .L0
    rm fh r0 r0 8
    mov fh r0 r1 10
    add r0 r1 r0
    wm fh r0 r0 8
.L0:
    rmr fh r16 r0 4
    mov fh r0 r1 FFFFFFFFh
    eq r0 r1 .L2
    mov fh r0 r0 0
    jmp .L3
.L2:
    mov fh r0 r0 1
.L3:
    mov fh r0 r1 0
    eq r0 r1 .L1
    rm fh r0 r0 8
    mov fh r0 r1 100
    add r0 r1 r0
    wm fh r0 r0 8
.L1:
    rm fh r0 r0 4
    mov fh r0 r1 FFFFFFFFh
    eq r0 r1 .L5
    rmr fh r16 r0 4
    mov fh r0 r1 FFFFFFFFh
    eq r0 r1 .L5
    mov fh r0 r0 1
    jmp .L6
.L5:
    mov fh r0 r0 0
.L6:
    mov fh r0 r1 0
    eq r0 r1 .L4
    mov fh r0 r0 0
    wm fh r0 r0 8
.L4:
    mov fh r0 r0 8
    add r16 r0 r16
    ret

set:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 4
    rmr fh r16 r1 0
    wm fh r1 r0
    mov fh r0 r0 8
    add r16 r0 r16
    ret
