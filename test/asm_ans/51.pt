.global add_base, main

main:
    mov fh r0 r0 3
    wm fh r0 r0 0
    mov fh r0 r0 2
    wmr fh r16 r0 -8
    call add_base
    mov fh r30 r0
    wm fh r0 r0 4
    ret

add_base:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    rm fh r0 r1 0
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
