.global value, main

main:
    mov fh r0 r0 1
    wm fh r0 r0 0
    mov fh r0 r0 2
    wm fh r0 r0 4
    mov fh r0 r0 3
    wm fh r0 r0 12
    call value
    mov fh r30 r0
    wm fh r0 r0 8
    rm fh r0 r0 0
    rm fh r0 r1 4
    add r0 r1 r0
    wm fh r0 r0 16
    rm fh r0 r0 8
    rm fh r0 r1 12
    add r0 r1 r0
    wm fh r0 r0 20
    ret

value:
    mov fh r0 r0 7
    mov fh r0 r30
    ret
    ret
