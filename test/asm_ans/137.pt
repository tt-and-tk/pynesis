.global add, main

main:
    mov fh r0 r0 12
    sub r16 r0 r16
    mov fh r0 r0 4
    wmr fh r16 r0 0
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    wmr fh r16 r0 4
    mov fh r0 r0 300
    rmr fh r16 r1 0
    wm 1h r1 r0
    mov fh r0 r0 1
    mov fh r0 r1 0
    sub r1 r0 r0
    mov fh r0 r1 255
    and r0 r1 r0
    rmr fh r16 r1 4
    wm 1h r1 r0
    mov fh r0 r0 0
    wmr fh r16 r0 8
.L0:
    rmr fh r16 r0 8
    mov fh r0 r1 3
    egt r0 r1 .L2
    rm fh r0 r0 0
    wmr fh r16 r0 -12
    rmr fh r16 r0 8
    wmr fh r16 r0 -8
    call add
    mov fh r30 r0
    wm fh r0 r0 0
.L1:
    rmr fh r16 r0 8
    mov fh r0 r1 1
    add r0 r1 r1
    wmr fh r16 r1 8
    jmp .L0
.L2:
    mov fh r0 r0 0
    mov fh r0 r1 4
    add r0 r1 r0
    rm 1h r0 r0
    wm fh r0 r0 8
    mov fh r0 r0 1
    mov fh r0 r1 4
    add r0 r1 r0
    rm 1h r0 r0
    wm fh r0 r0 12
    mov fh r0 r0 1
    mov fh r0 r1 4
    add r0 r1 r0
    wm fh r0 r0 16
    rm fh r0 r0 0
    wm fh r0 r0 20
    mov fh r0 r0 12
    add r16 r0 r16
    ret

add:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    ret
    mov fh r0 r0 8
    add r16 r0 r16
    ret
