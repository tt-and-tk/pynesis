.global f, main

main:
    mov fh r0 r0 97
    wm fh r0 r0 24
    mov fh r0 r0 24
    wmr fh r16 r0 -8
    call f
    mov fh r30 r0
    mov fh r0 r1 16
    add r0 r1 r0
    wm fh r0 r0 20
    ret

f:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 4
    mov fh r0 r1 4
    eq r0 r1 .L0
    jmp .L1
.L0:
    mov fh r0 r0 1
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
.L1:
    mov fh r0 r0 0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
