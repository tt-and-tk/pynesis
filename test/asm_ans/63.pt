.global main

main:
    mov fh r0 r0 1
    wm fh r0 r0 0
    mov fh r0 r0 -1
    wm fh r0 r0 4
    rm fh r0 r0 0
    not r0 r0
    mov fh r0 r1 1
    gtu r0 r1 .L0
    mov fh r0 r0 0
    jmp .L1
.L0:
    mov fh r0 r0 1
.L1:
    wm fh r0 r0 8
    rm fh r0 r0 0
    mov fh r0 r1 0
    eq r0 r1 .L4
    mov fh r0 r0 0
    jmp .L5
.L4:
    mov fh r0 r0 1
.L5:
    rm fh r0 r1 4
    lt r0 r1 .L2
    mov fh r0 r0 0
    jmp .L3
.L2:
    mov fh r0 r0 1
.L3:
    wm fh r0 r0 8
    ret
