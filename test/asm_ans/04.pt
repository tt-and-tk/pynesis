.global main

main:
    mov fh r0 r0 8
    sub r16 r0 r16
    mov fh r0 r0 4
    wm fh r0 r0 0
    mov fh r0 r0 10
    wmr fh r16 r0 0
    rm fh r0 r0 0
    rmr fh r16 r1 0
    add r0 r1 r0
    wmr fh r16 r0 4
    mov fh r0 r0 7
    wmr fh r16 r0 0
    rmr fh r16 r0 0
    wm fh r0 r0 0
    rmr fh r16 r0 0
    mov fh r0 r1 3
    add r0 r1 r0
    wmr fh r16 r0 0
    rm fh r0 r0 0
    mov fh r0 r1 1
    sll r0 r1 r0
    wm fh r0 r0 0
    mov fh r0 r0 8
    add r16 r0 r16
    ret
