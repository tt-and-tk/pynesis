    mov fh r0 r2 8
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    call first
    mov fh r30 r0
    wmr fh r16 r0 0
    mov fh r0 r0 0
    add r16 r0 r0
    wmr fh r16 r0 4
    rmr fh r16 r0 4
    rm fh r0 r0
    mov fh r0 r1 4
