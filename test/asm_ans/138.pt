.global swap, main

main:
    mov fh r0 r0 8
    sub r16 r0 r16
    mov fh r0 r0 1
    wm fh r0 r0 0
    mov fh r0 r0 2
    wm fh r0 r0 4
    mov fh r0 r0 0
    mov fh r0 r1 8
    mov fh r1 r2
    mov fh r0 r4 4
    mov fh r0 r3 8
    add r0 r3 r3
.L0:
    rm fh r0 r5
    wm fh r2 r5
    add r0 r4 r0
    add r2 r4 r2
    ne r0 r3 .L0
    mov fh r1 r0
    mov fh r0 r0 8
    wmr fh r16 r0 -8
    call swap
    mov fh r0 r0 10
    mov fh r0 r1 0
    mov fh r0 r2 8
    mul r1 r2 r1
    mov fh r0 r2 16
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 1
    mov fh r0 r1 8
    mul r0 r1 r0
    mov fh r0 r1 16
    add r0 r1 r0
    mov fh r0 r1 0
    mov fh r0 r2 8
    mul r1 r2 r1
    mov fh r0 r2 20
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 20
    mov fh r0 r1 1
    mov fh r0 r2 8
    mul r1 r2 r1
    mov fh r0 r2 16
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 80000000h
    mov fh r0 r1 1
    mov fh r0 r2 8
    mul r1 r2 r1
    mov fh r0 r2 20
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 0
    mov fh r0 r1 8
    mul r0 r1 r0
    mov fh r0 r1 16
    add r0 r1 r0
    mov fh r0 r1 0
    add r16 r1 r1
    mov fh r1 r2
    mov fh r0 r4 4
    mov fh r0 r3 8
    add r0 r3 r3
.L1:
    rm fh r0 r5
    wm fh r2 r5
    add r0 r4 r0
    add r2 r4 r2
    ne r0 r3 .L1
    mov fh r1 r0
    rm fh r0 r0 8
    mov fh r0 r1 10
    mul r0 r1 r0
    rm fh r0 r1 12
    add r0 r1 r0
    wm fh r0 r0 32
    rmr fh r16 r0 4
    rm fh r0 r0
    wm fh r0 r0 36
    mov fh r0 r0 8
    add r16 r0 r16
    ret

swap:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 4
    rm fh r0 r0
    wmr fh r16 r0 0
    rmr fh r16 r0 4
    mov fh r0 r1 4
    add r0 r1 r0
    rm fh r0 r0
    rmr fh r16 r1 4
    wm fh r1 r0
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    mov fh r0 r2 4
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 8
    add r16 r0 r16
    ret
