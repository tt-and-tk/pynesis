.global main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 5
    wm fh r0 r0 16
    mov fh r0 r0 0
    wmr fh r16 r0 0
.L0:
    rmr fh r16 r0 0
    mov fh r0 r1 4
    egt r0 r1 .L2
    rm fh r0 r0 16
    mov fh r0 r1 2
    add r0 r1 r0
    wm fh r0 r0 16
.L1:
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    wmr fh r16 r0 0
    jmp .L0
.L2:
    rm fh r0 r0 16
    mov fh r0 r1 8
    mov fh r0 r2 5
    add r1 r2 r1
    ne r0 r1 .L3
    mov fh r0 r0 -3
    wm fh r0 r0 16
.L3:
    rm fh r0 r0 16
    mov fh r0 r1 -3
    eq r0 r1 .L4
    jmp .L5
.L4:
    mov fh r0 r0 16
    mov fh r0 r1 8
    add r0 r1 r0
    wm fh r0 r0 16
    jmp .L5
.L5:
    mov fh r0 r0 4
    add r16 r0 r16
    ret
