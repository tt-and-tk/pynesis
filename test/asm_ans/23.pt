.global sadd, main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 3
    wmr fh r16 r0 -12
    mov fh r0 r0 5
    wmr fh r16 r0 -8
    call sadd
    mov fh r30 r0
    wmr fh r16 r0 0
    mov fh r0 r0 4
    add r16 r0 r16
    ret

sadd:
    mov fh r0 r0 12
    sub r16 r0 r16
    rmr fh r16 r0 4
    rmr fh r16 r1 8
    add r0 r1 r0
    wmr fh r16 r0 0
    rmr fh r16 r0 0
    mov fh r0 r30
    mov fh r0 r0 12
    add r16 r0 r16
    ret
    mov fh r0 r0 12
    add r16 r0 r16
    ret
