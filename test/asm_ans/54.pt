.global low, main

main:
    mov fh r0 r0 8
    sub r16 r0 r16
    mov fh r0 r0 200
    wm 1h r0 r0 0
    mov fh r0 r0 60000
    wmr 3h r16 r0 0
    mov fh r0 r0 1
    wmr fh r16 r0 4
    rm 1h r0 r0 0
    wm 3h r0 r0 4
    rmr 3h r16 r0 0
    wm fh r0 r0 8
    rm 1h r0 r0 0
    rmr fh r16 r1 4
    mov fh r0 r2 12
    add r1 r2 r1
    wm 1h r1 r0
    rmr fh r16 r0 4
    mov fh r0 r1 12
    add r0 r1 r0
    rm 1h r0 r0
    wm fh r0 r0 8
    rmr fh r16 r1 4
    mov fh r0 r2 12
    add r1 r2 r1
    mov fh r1 r0
    rm 1h r0 r0
    mov fh r0 r2 1
    add r0 r2 r0
    wm 1h r1 r0
    rmr 3h r16 r0 0
    wm 3h r0 r0 16
    rm 3h r0 r0 16
    wm fh r0 r0 8
    rmr fh r16 r0 4
    mov fh r0 r1 20
    add r0 r1 r0
    rm 1h r0 r0
    wm fh r0 r0 8
    rmr fh r16 r0 4
    mov fh r0 r1 8
    mul r0 r1 r0
    mov fh r0 r1 24
    add r0 r1 r0
    rm 3h r0 r0
    wm fh r0 r0 8
    mov fh r0 r0 FFFFFFFFh
    wmr fh r16 r0 -8
    call low
    mov fh r30 r0
    wm fh r0 r0 8
    mov fh r0 r0 8
    add r16 r0 r16
    ret

low:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
