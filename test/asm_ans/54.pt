    wm fh r0 r0 8
    rm 1h r0 r0 0
    rm fh r0 r1 48
    mov fh r0 r2 12
    add r1 r2 r1
    wm 1h r1 r0
    rm fh r0 r0 48
    mov fh r0 r1 12
    add r0 r1 r0
    rm 1h r0 r0
    wm fh r0 r0 8
    rm fh r0 r1 48
    mov fh r0 r2 12
    add r1 r2 r1
    mov fh r1 r0
    rm 1h r0 r0
    mov fh r0 r2 1
