.global plus, minus, main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 1
    wmr fh r16 r0 0
    mov fh r0 r0 plus
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 minus
    rmr fh r16 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 80000000h
    mov fh r0 r1 2
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    rmr fh r16 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 7
    wmr fh r16 r1 -12
    mov fh r0 r1 2
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 12
    mov fh r0 r0 2
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 80000000h
    ne r0 r1 .L0
    mov fh r0 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 2
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
.L0:
    mov fh r0 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 2
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    rm fh r1 r1
    ne r0 r1 .L1
    mov fh r0 r0 2
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    rm fh r0 r1 12
    wmr fh r16 r1 -12
    mov fh r0 r1 1
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 12
.L1:
    rmr fh r16 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 80000000h
    eq r0 r1 .L2
    rm fh r0 r0 12
    mov fh r0 r1 1
    add r0 r1 r0
    wm fh r0 r0 12
.L2:
    mov fh r0 r0 12
    wm fh r0 r0 16
    mov fh r0 r0 4
    add r16 r0 r16
    ret

plus:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    ret
    mov fh r0 r0 8
    add r16 r0 r16
    ret

minus:
    mov fh r0 r0 8
    sub r16 r0 r16
    rmr fh r16 r0 0
    rmr fh r16 r1 4
    sub r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 8
    add r16 r0 r16
    ret
    mov fh r0 r0 8
    add r16 r0 r16
    ret
