.global entry, framed, main

main:
    call entry
    mov fh r0 r0 1
    wmr fh r16 r0 -8
    call framed
    mov fh r30 r0
    wm fh r0 r0 0
    ret

entry:
    wm fh r0 r5 0
    mov fh r0 r0 0
    wm fh r0 r0 0
    ret

framed:
    mov fh r0 r0 4
    sub r16 r0 r16
    nop
    rmr fh r16 r0 0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
