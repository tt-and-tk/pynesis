.global main

main:
    mov fh r0 r0 4
    wm fh r0 r0 0
    mov fh r0 r0 7
    wm fh r0 r0 12
    rm fh r0 r0 12
    wm fh r0 r0 0
    mov fh r0 r0 10
    wm fh r0 r0 0
    mov fh r0 r0 3
    wm fh r0 r0 4
.L0:
    rm fh r0 r0 0
    mov fh r0 r1 2
    egt r0 r1 .L2
.L1:
    rm fh r0 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    wm fh r0 r0 0
    jmp .L0
.L2:
    ret
