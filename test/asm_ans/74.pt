.global leaf, inner, outer, main

main:
    mov fh r0 r0 10
    wmr fh r16 r0 -12
    mov fh r0 r0 20
    wmr fh r16 r0 -8
    call outer
    mov fh r30 r0
    wm fh r0 r0 0
    ret

leaf:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret

inner:
    mov fh r0 r0 12
    sub r16 r0 r16
    rmr fh r16 r0 4
    wmr fh r16 r0 0
    rmr fh r16 r1 8
    wmr fh r16 r1 -8
    call leaf
    mov fh r30 r1
    rmr fh r16 r0 0
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 12
    add r16 r0 r16
    ret
    mov fh r0 r0 12
    add r16 r0 r16
    ret

outer:
    mov fh r0 r0 12
    sub r16 r0 r16
    rmr fh r16 r0 4
    wmr fh r16 r0 0
    rmr fh r16 r1 4
    wmr fh r16 r1 -12
    rmr fh r16 r1 8
    wmr fh r16 r1 -8
    call inner
    mov fh r30 r1
    rmr fh r16 r0 0
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 12
    add r16 r0 r16
    ret
    mov fh r0 r0 12
    add r16 r0 r16
    ret
