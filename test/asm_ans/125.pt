    mov fh r0 r0 1
    wmr fh r16 r0 8
    mov fh r0 r0 twice
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r16 r2 r2
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 negate
    rmr fh r16 r1 8
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r16 r2 r2
    add r1 r2 r1
    wm fh r1 r0
    rmr fh r16 r0 8
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r16 r1 r1
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 3
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 36
    mov fh r0 r0 twice
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 4
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 0
