    mov fh r30 r0
    wm fh r0 r0 48
    mov fh r0 r0 12
    add r16 r0 r16
    ret

twice:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r1 2
    mul r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret

negate:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 0
    rmr fh r16 r1 0
    sub r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret

run:
    mov fh r0 r0 12
    sub r16 r0 r16
    rmr fh r16 r0 4
    mov fh r0 r1 2
    sll r0 r1 r0
    rmr fh r16 r1 0
    mov fh r0 r2 4
    add r1 r2 r1
    add r0 r1 r0
    rm fh r0 r0
    rmr fh r16 r1 8
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    mov fh r0 r30
    mov fh r0 r0 12
    add r16 r0 r16
    ret
    mov fh r0 r0 12
    add r16 r0 r16
