    sll r0 r1 r0
    mov fh r0 r1 4
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 4
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 40
    mov fh r0 r0 negate
    rmr fh r16 r1 8
    mov fh r0 r2 2
    sll r1 r2 r1
    rmr fh r16 r2 8
    mov fh r0 r3 12
    mul r2 r3 r2
    mov fh r0 r3 16
    add r2 r3 r2
    add r1 r2 r1
    wm fh r1 r0
    rmr fh r16 r0 8
    mov fh r0 r1 2
    sll r0 r1 r0
    rmr fh r16 r1 8
    mov fh r0 r2 12
    mul r1 r2 r1
    mov fh r0 r2 16
    add r1 r2 r1
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 5
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 44
