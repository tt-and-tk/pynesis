.global f, main

main:
    mov fh r0 r0 16
    sub r16 r0 r16
    mov fh r0 r0 10
    wmr fh r16 r0 0
    mov fh r0 r0 20
    wmr fh r16 r0 4
    rmr fh r16 r0 0
    wmr fh r16 r0 12
    rmr fh r16 r1 4
    wmr fh r16 r1 -8
    call f
    mov fh r30 r1
    rmr fh r16 r0 12
    add r0 r1 r0
    wmr fh r16 r0 8
    mov fh r0 r0 16
    add r16 r0 r16
    ret

f:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
