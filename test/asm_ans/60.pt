.global main

main:
    mov fh r0 r0 80000000h
    wm fh r0 r0 0
    rm fh r0 r0 0
    mov fh r0 r1 4
    srl r0 r1 r0
    wm fh r0 r0 0
    mov fh r0 r1 1
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 4
    add r1 r2 r1
    mov fh r1 r0
    rm fh r0 r0
    mov fh r0 r2 4
    srl r0 r2 r0
    wm fh r1 r0
    ret
