.global seven, main

main:
    mov fh r0 r0 0
    wm fh r0 r0 8
    mov fh r0 r0 10
    rm fh r0 r1 8
    mov fh r0 r2 4
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    rm fh r0 r1 8
    mov fh r0 r2 4
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    mov fh r1 r0
    rm fh r0 r0
    mov fh r0 r2 5
    add r0 r2 r0
    wm fh r1 r0
    rm fh r0 r1 8
    mov fh r0 r2 4
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    mov fh r1 r0
    rm fh r0 r0
    wm fh r0 r0 12
    wm fh r0 r1 16
    call seven
    mov fh r30 r2
    rm fh r0 r0 12
    rm fh r0 r1 16
    add r0 r2 r0
    wm fh r1 r0
    ret

seven:
    mov fh r0 r0 7
    mov fh r0 r30
    ret
    ret
