.global twice.0, shadow, main

main:
    mov fh r0 r0 twice.0
    wm fh r0 r0 8
    rm fh r0 r0 8
    mov fh r0 r1 8
    wmr fh r16 r1 -8
    call r0
    mov fh r30 r0
    wm fh r0 r0 12
    mov fh r0 r0 2
    wmr fh r16 r0 -8
    call shadow
    mov fh r30 r0
    wm fh r0 r0 12
    ret

twice.0:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r1 2
    mul r0 r1 r0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret

shadow:
    mov fh r0 r0 4
    sub r16 r0 r16
    rmr fh r16 r0 0
    mov fh r0 r30
    mov fh r0 r0 4
    add r16 r0 r16
    ret
    mov fh r0 r0 4
    add r16 r0 r16
    ret
