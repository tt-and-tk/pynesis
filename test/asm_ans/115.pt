.global lib_read, main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 3
    mov fh r0 r1 1
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 8
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 1
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 8
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r1 1
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 20
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 4
    wm fh r0 r0 16
    mov fh r0 r0 5
    wmr fh r16 r0 0
    rmr fh r16 r0 0
    wm fh r0 r0 28
    call lib_read
    mov fh r30 r0
    wm fh r0 r0 28
    mov fh r0 r0 4
    add r16 r0 r16
    ret

lib_read:
    mov fh r0 r0 6
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 0
    mov fh r0 r1 2
    sll r0 r1 r0
    mov fh r0 r1 0
    add r0 r1 r0
    rm fh r0 r0
    mov fh r0 r30
    ret
    ret
