.global one, main

main:
    mov fh r0 r0 12
    sub r16 r0 r16
    mov fh r0 r0 1
    wmr fh r16 r0 0
    mov fh r0 r0 9
    rmr fh r16 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    wmr fh r16 r0 4
    wmr fh r16 r1 8
    call one
    mov fh r30 r2
    rmr fh r16 r0 4
    rmr fh r16 r1 8
    mov fh r0 r3 12
    mul r2 r3 r2
    mov fh r0 r3 4
    add r2 r3 r2
    add r1 r2 r1
    wm fh r1 r0
    mov fh r0 r0 12
    add r16 r0 r16
    ret

one:
    mov fh r0 r0 1
    mov fh r0 r30
    ret
    ret
