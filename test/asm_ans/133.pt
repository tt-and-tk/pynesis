.global f, main

main:
    mov fh r0 r0 0
    mov fh r0 r1 0
    mov fh r0 r2 2
    sll r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm fh r1 r0
    call f
    ret

f:
    mov fh r0 r0 1
    mov fh r0 r1 2
    mov fh r0 r2 3
    mov fh r0 r3 4
    mov fh r0 r4 5
    mov fh r0 r5 24
    sub r16 r5 r16
    wmr fh r16 r0 4
    wmr fh r16 r1 8
    wmr fh r16 r2 12
    wmr fh r16 r3 16
    wmr fh r16 r4 20
    syscall
    rmr fh r16 r0 0
    mov fh r0 r5 24
    add r16 r5 r16
    ret
