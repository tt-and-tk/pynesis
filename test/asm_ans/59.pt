.global main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 1
    wmr fh r16 r0 0
    mov fh r0 r0 65535
    rmr fh r16 r1 0
    mov fh r0 r2 4
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm 3h r1 r0
    rmr fh r16 r1 0
    mov fh r0 r2 4
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    mov fh r1 r0
    rm 3h r0 r0
    mov fh r0 r2 1
