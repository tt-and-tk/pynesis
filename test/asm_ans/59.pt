.global main

main:
    mov fh r0 r0 1
    wm fh r0 r0 8
    mov fh r0 r0 65535
    rm fh r0 r1 8
    mov fh r0 r2 4
    mul r1 r2 r1
    mov fh r0 r2 0
    add r1 r2 r1
    wm 3h r1 r0
    rm fh r0 r1 8
    mov fh r0 r2 4
