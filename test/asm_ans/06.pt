.global main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 0
    wm fh r0 r0 0
    mov fh r0 r0 0
    wmr fh r16 r0 0
.L0:
    rmr fh r16 r0 0
    mov fh r0 r1 5
    egt r0 r1 .L1
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    wmr fh r16 r0 0
    rmr fh r16 r0 0
    mov fh r0 r1 2
    ne r0 r1 .L2
    jmp .L0
.L2:
    rmr fh r16 r0 0
    mov fh r0 r1 4
    ne r0 r1 .L3
    jmp .L1
.L3:
    rm fh r0 r0 0
    rmr fh r16 r1 0
    add r0 r1 r0
    wm fh r0 r0 0
    jmp .L0
.L1:
    mov fh r0 r0 4
    add r16 r0 r16
    ret
