.global helper, main

main:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 0
    wm fh r0 r0 0
    mov fh r0 r0 0
    wmr fh r16 r0 0
.L0:
    rmr fh r16 r0 0
    mov fh r0 r1 3
    egt r0 r1 .L2
    call helper
.L1:
    rmr fh r16 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    wmr fh r16 r0 0
    jmp .L0
.L2:
    mov fh r0 r0 4
    add r16 r0 r16
    ret

helper:
    mov fh r0 r0 4
    sub r16 r0 r16
    mov fh r0 r0 5
    wmr fh r16 r0 0
    rm fh r0 r0 0
    rmr fh r16 r1 0
    add r0 r1 r0
    wm fh r0 r0 0
    mov fh r0 r0 4
    add r16 r0 r16
    ret
