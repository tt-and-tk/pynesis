.global main

main:
    mov fh r0 r0 -1
    wm fh r0 r0 4
    mov fh r0 r0 5
    wm fh r0 r0 0
    rm fh r0 r1 4
    ltu r0 r1 .L0
    mov fh r0 r0 0
    jmp .L1
.L0:
    mov fh r0 r0 1
.L1:
    wm fh r0 r0 8
    rm fh r0 r0 0
    mov fh r0 r1 1
    add r0 r1 r1
    wm fh r0 r1 0
    rm fh r0 r1 4
    ltu r0 r1 .L2
    mov fh r0 r0 0
    jmp .L3
.L2:
    mov fh r0 r0 1
.L3:
    wm fh r0 r0 8
    rm fh r0 r0 0
    mov fh r0 r1 1
    add r0 r1 r0
    wm fh r0 r0 0
    mov fh r0 r1 2
    divu r0 r1 r0
    wm fh r0 r0 8
    ret
