// 実行ファイル用: syscallは，番号と引数4つを順にレジスタへ評価してから，SPを24バイト下げてSP+4〜SP+20へ並べ，
// syscallの命令を実行する．OSがSP+0へ書き込んだ戻り値を式の値として読み，SPを戻す
// - 二項演算の右辺でsyscallを呼ぶ場合は，評価済みの左辺のレジスタを退避・復元する(OSがレジスタを使い直すため)
// - 引数の中で関数を呼ぶ場合は，評価済みの番号と引数のレジスタを退避・復元する
// - ポインタはintへキャストして渡す
int g;
int id(int x) {
    return x;
}
int main(void) {
    int buf[2];
    g = syscall(1, (int)buf, 2, 3, 4);
    g = g + syscall(4, 0, 0, 0, 0);
    g = syscall(2, 5, id(6), 0, 0);
    return g;
}
