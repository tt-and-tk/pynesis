// 最上位が番地の取得・構造体メンバ・単項演算・短絡評価の式文も評価され，含まれる副作用が実行される
// 構造体の配列と文字列リテラルの式文は先頭の番地を求めるだけになる．for文の更新にはvoid関数の呼び出しを書ける
struct Point { int x; int y; };
struct Point s;
struct Point sa[2];
int g[2];
int n;
int t;

int next(void) {
    n++;
    return n;
}

void tick(void) {
    t++;
}

void main(void) {
    int i = 0;
    struct Point *sp = &s;
    &g[i++];                      // 番地の取得の中の++: iが1増える
    s.x;                          // 構造体変数のメンバの読み出し
    sp->y;                        // 構造体ポインタの指す先のメンバの読み出し
    sa[i++].x;                    // 構造体配列要素のメンバの添字の中の++: iが1増える
    sa;                           // 構造体の配列は先頭要素の番地になる
    -next();                      // 単項演算の中の関数呼び出し
    1 + i++;                      // 二項演算の右辺の++: iが1増える
    n && next();                  // 短絡評価の右辺の関数呼び出し
    "ab";                         // 文字列リテラルは先頭の番地になる
    for (i = 0; i < 2; tick()) {  // for文の更新のvoid関数呼び出し
    }
}
