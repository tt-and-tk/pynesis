// ポインタの加減算: 整数を足し引きすると指す先の型のバイト数を単位にずれ，同じ型のポインタどうしの差は要素数になる
// 大小比較は番地を符号なしの値として比べる．++/--・+=/-=も指す先1個分を単位に動かす
int ia[4];
short sa[4];
char ca[4];
int d1;
int d2;
int d3;
int lt;

void main(void) {
    int *ip = ia + 3;         // 3要素分(12バイト)先
    short *sp = 1 + sa;       // 整数+ポインタも同じ
    char *cp = ca;
    ip = ip - 1;
    sp++;
    --ip;
    cp += 3;
    d1 = ip - ia;             // 1
    d2 = sp - sa;             // 2
    d3 = cp - ca;             // 3
    lt = ia < ip;             // 符号なしの比較
}
