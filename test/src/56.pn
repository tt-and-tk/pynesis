// 条件としての符号なし大小比較: 偽で分岐する側(if/while/for)は否定の命令を使い，&&の中や式の値としての比較はそのままの命令で0/1を作る
unsigned int n = 0xFFFFFFFF;
int g;

void main(void) {
    unsigned int i;
    if (n > 1) {                     // 否定: eltu
        g = 1;
    }
    for (i = 0; i <= 3; i++) {       // 否定: gtu
        g = 2;
    }
    while (i >= n) {                 // 否定: ltu
        g = 3;
    }
    do {
        i--;
    } while (i != 0 && i < 5);       // &&の中の比較は値として生成: ltu
    g = (g < 0 ? n : 1) > 2;         // 三項演算子の結果はunsigned int: gtu
    g = -i > 0;                      // 単項マイナスの結果はunsigned int: gtu
}
