// asm文の入力"i": 雛形の%Nを，N番目(0始まり)の入力の値に置き換える
// - 整数の定数式(const変数・sizeof・演算)．負の値は10進で，0x80000000以上の値は16進(末尾h)で書く
// - const unsigned intの定数を含む式は符号なしとして計算する(ONE - 2 < 0は0)
// - グローバル変数の番地: &変数，配列名，&配列[定数]，&構造体.メンバ，メンバ配列名，&メンバ配列[定数]，
//   &構造体配列[定数].メンバ，&構造体配列[定数].メンバ配列[定数]，番地±整数定数，整数定数+番地
// - staticを付けたグローバル変数の番地
// - %10のように数字を続けて読む．同じ入力を何度も使え，コメントの中の%Nも置き換える．使わない入力があってもよい
// (aは0番地，arrは4番地，hsは20番地，pは28番地，psは40番地，sは64番地に置かれる．構造体ptは，xが先頭から0バイト，nameが4バイトの位置で，全体が12バイト)
struct pt {
    int x;
    char name[6];
};
const int N = 3;
const unsigned int ONE = 1;
int a;
int arr[4];
short hs[3];
struct pt p;
struct pt ps[2];
static int s;
void main(void) {
    asm("mov fh r0 r1 %0   ; %0\n"
        "mov fh r0 r1 %1\n"
        "mov fh r0 r1 %2\n"
        "mov fh r0 r1 %3\n"
        "mov fh r0 r1 %4\n"
        "wm fh r0 r1 %5\n"
        "wm fh r0 r1 %6\n"
        "wm fh r0 r1 %7\n"
        "wm fh r0 r1 %8\n"
        "wm fh r0 r1 %9\n"
        "wm fh r0 r1 %10\n"
        "wm fh r0 r1 %11\n"
        "wm fh r0 r1 %12\n"
        "wm fh r0 r1 %13\n"
        "wm fh r0 r1 %14\n"
        "wm fh r0 r1 %15\n"
        "wm fh r0 r1 %16\n"
        "wm fh r0 r1 %17"
        :
        : "i"(N * 2 + 1),          // 7
          "i"(-5),                 // -5
          "i"(0x80000000),         // 80000000h
          "i"(ONE - 2 < 0),        // 0
          "i"(sizeof(p)),          // 12
          "i"(&a),                 // 0
          "i"(arr),                // 4
          "i"(&arr[N]),            // 4 + 3 * 4 = 16
          "i"(&hs[2]),             // 20 + 2 * 2 = 24
          "i"(&p.x),               // 28
          "i"(p.name),             // 28 + 4 = 32
          "i"(&p.name[5]),         // 32 + 5 = 37
          "i"(&ps[1].x),           // 40 + 12 = 52
          "i"(&ps[1].name[2]),     // 52 + 4 + 2 = 58
          "i"(arr + 2),            // 4 + 2 * 4 = 12
          "i"(1 + &arr[1]),        // 8 + 4 = 12
          "i"(&arr[3] - 1),        // 16 - 4 = 12
          "i"(&s),                 // 64
          "i"(0));                 // 使わない
}
