// asm文: 雛形の各行を，書いた位置にそのままの順で出力する
// - 入力欄を持たない形(asm(雛形);・asm(雛形 : );)を書ける
// - 行の前後の空白を除き，空行は捨てる．命令の行は字下げし，コメントだけの行も命令の行と同じく字下げする
// - ;より前に:を含む行は局所ラベルの行として行頭に置き，同じ行のコメントも残す
// - asm文の前後の文は通常どおり生成する
int g;
void main(void) {
    g = 1;
    asm("nop");
    asm("  mov fh r0 r1 5  \n"
        "\n"
        "mov fh r0 r2 1\n"
        "; 1ずつ減らす\n"
        ".count:   ; ループの先頭\n"
        "sub r1 r2 r1\n"
        "ne r1 r0 .count" : );
    g = 2;
}
