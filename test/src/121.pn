// asm文: 行の種類の見分け方と，書ける位置
// - ;より後ろの:は見分けに使わない(命令の行とコメントだけの行は，:を含んでも字下げする)
// - コメントの中には.Lに数字が続く名前を書ける．.Lに英字が続く名前はラベルにも使える
// - 入力欄が空の形(asm(雛形 : : );)を書ける
// - if・forの本体，入れ子のブロック，switchのcaseの後ろにも書ける
// - mainの本体の最初に書いても，グローバル変数の初期値の書き込みが先に出力される
int g = 3;
void main(void) {
    asm("nop ; 注: 説明\n"
        "; a: b\n"
        "; .L1 はコンパイラのラベル\n"
        ".Lmy%=:\n"
        "ne r0 r0 .Lmy%=" : : );
    if (g == 3)
        asm("nop");
    for (; g < 5; g = g + 1) {
        {
            asm("nop");
        }
    }
    switch (g) {
        case 5:
            asm("nop");
            break;
    }
}
