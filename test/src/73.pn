// 深い呼び出しネスト (11段)
// 戻り先はメモリ上のスタックへ積むため，段数に固定の上限はない
int g;
void f11(void) { g = 11; }
void f10(void) { f11(); }
void f9(void)  { f10(); }
void f8(void)  { f9(); }
void f7(void)  { f8(); }
void f6(void)  { f7(); }
void f5(void)  { f6(); }
void f4(void)  { f5(); }
void f3(void)  { f4(); }
void f2(void)  { f3(); }
void f1(void)  { f2(); }
void main(void) {
    f1();
}
