// フレームを持たない関数では，複合代入・前置/後置の++/--でもSPへ書き込め，if文の中にも書ける
// フレームを持つ関数でもSPは読み出せる．KENTRY・EENTRYも読み出せる
// フレームを持たない関数のif文の中でも，syscallでシステムコールを呼べる
unsigned int flag;

void adjust_sp(void) {
    if (flag) {
        SP += 8;            // 複合代入
        SP--;               // 後置デクリメント
        ++SP;               // 前置インクリメント
        syscall(1, 2, 3, 4, 5);
    }
}

void read_regs(void) {
    unsigned int sp = SP;   // ローカル変数を持つ(フレームを持つ)関数でのSPの読み出し
    flag = KENTRY + EENTRY;
}

void main(void) {
    adjust_sp();
    read_regs();
}
