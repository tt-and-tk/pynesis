// フレームを持たない関数では，複合代入・前置/後置の++/--でもSPへ書き込め，if文の中にも書ける
// フレームを持つ関数でもSPは読み出せる．KENTRY・EENTRYも読み出せる
// SYSCALL()はif文の中の文としても書ける．小文字のsyscall・sysretは予約語ではなく，関数名に使える
unsigned int flag;

void syscall(void) {
    if (flag) {
        SP += 8;            // 複合代入
        SP--;               // 後置デクリメント
        ++SP;               // 前置インクリメント
        SYSCALL();
    }
}

void sysret(void) {
    unsigned int sp = SP;   // ローカル変数を持つ(フレームを持つ)関数でのSPの読み出し
    flag = KENTRY + EENTRY;
}

void main(void) {
    syscall();
    sysret();
}
