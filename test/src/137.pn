// typedefで整数型・ポインタ・別のtypedef名に別名を付け，元の型と同じ型として使える
// typedef名は宣言の順序によらず使え，constを前に付けられ，キャスト・sizeofにも書ける
Count total;                     // 後で宣言したtypedef名を使う
typedef unsigned char Byte;
typedef Byte *BytePtr;           // 別のtypedef名のポインタに別名を付ける
typedef int Count;
typedef Count Number;            // 別のtypedef名に別名を付ける
const Number LIMIT = 3;          // constを前に付ける
Byte buf[4];
int r1;
int r2;
int r3;
int r4;

Number add(Number a, Count b) {
    return a + b;
}

void main(void) {
    BytePtr p = buf;
    Byte *q = p + 1;             // typedef名のポインタは，元の型のポインタと同じ型
    *p = 300;                    // unsigned charへ格納するため44になる
    *q = (Byte)-1;               // 255
    for (Count i = 0; i < LIMIT; i++) {
        total = add(total, i);   // 0 + 1 + 2 = 3
    }
    r1 = buf[0];                 // 44
    r2 = buf[1];                 // 255
    r3 = sizeof(Byte) + sizeof(BytePtr);   // 1 + 4 = 5
    r4 = total;                  // 3
}
