// 関数の本体の中の内側のブロックスコープでは，引数と同じ名前の変数を宣言でき，引数とは別の変数になる(シャドーイング)
// 内側のブロックスコープを抜けると，その名前は再び引数を指す
int r1;
int r2;
int r3;
int r4;

int f(int a) {
    {
        int a = 10;
        r1 = a;                   // 10 (ブロックの変数)
    }
    for (int a = 20; a < 21; a++) {
        r2 = a;                   // 20 (for文の初期化部の変数)
    }
    switch (a) {
        case 3:
            int a = 30;
            r3 = a;               // 30 (switch本体の変数)
            break;
    }
    return a;                     // 3 (引数)
}

void main(void) {
    r4 = f(3);
}
