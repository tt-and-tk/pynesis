// 組み込み関数syscallを呼ぶ関数では，システムコールの値を並べる24バイトもスタックの量に数える
// mainのフレームはなく，fの呼び出しで戻り先の4バイトを積み，fの中のsyscallで24バイトを積む．
// グローバル変数との合計がちょうどカーネル用の範囲の大きさ(32768バイト)になり，収まるものとして通る
int table[8185];                  // 32740バイト
void f(void) {
    syscall(1, 2, 3, 4, 5);
}
void main(void) {
    table[0] = 0;
    f();
}
