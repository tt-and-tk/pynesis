// 式文は最上位の種類によらず評価され，含まれる副作用(++/--・代入・関数呼び出し)が実行される
// 副作用を持たない式文も評価され，値を読む命令が出力される(配列は先頭要素の番地になる)
int g[3];
int *p;
int n;

int next(void) {
    n++;
    return n;
}

void main(void) {
    int i = 0;
    int *q = g;
    p = g;
    *p++;                         // 間接参照の対象の後置++: pが1要素進む
    i++ + 1;                      // 二項演算の中の++: iが1増える
    g[i++];                       // 添字の中の++: iが1増える
    n ? next() : 0;               // 三項演算子の中の関数呼び出し
    for (i = 0; i < 2; *q++) {    // for文の更新: qが1要素ずつ進む
    }
    n;                            // 副作用を持たない変数の読み出し
    g;                            // 配列は先頭要素の番地になる
}
