// 定数式のシフト: シフト量は32ビットのビット列を符号なし整数とみなした値で，32以上なら全ビットがあふれる
const unsigned int BIG = 0xFFFFFFF0;
int shl31 = 1 << 31;                 // 32未満で最大のシフト量はそのままシフトする: -2147483648
int shl32 = 1 << 32;                 // 左シフトはシフト量32以上で0
int sar = -16 >> 40;                 // 符号付きの負の値の右シフトはシフト量32以上で-1
int sar_pos = 16 >> 40;              // 符号付きの正の値の右シフトはシフト量32以上で0
unsigned int shr = BIG >> 40;        // 符号なしの右シフトはシフト量32以上で0
int shl_neg = 1 << -1;               // 負のシフト量も32以上とみなす: 0
int sar_neg = -16 >> -1;             // 負のシフト量の算術右シフトも符号ビットで埋まる: -1
int sar32 = -16 >> 32;               // 符号付きの負の値の右シフトはシフト量32ちょうどで-1
int shl64 = 1 << 64;                 // C++のシフト演算子が未定義動作になる64以上のシフト量でも，左シフトは0
int shl_big = 1 << BIG;              // unsigned intのシフト量も同じく扱う(BIGは32以上): 0

void main(void) {
}
