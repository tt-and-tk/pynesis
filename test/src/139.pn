// typedefで列挙型に別名を付ける (列挙型名を書いた定義・無名の列挙型の定義・定義済みの列挙型)
typedef enum Color {
    RED,
    GREEN,
    BLUE,
} color_t;
typedef enum {
    IDLE = 5,
    BUSY,
} state_t;
typedef enum Color paint_t;      // 定義済みの列挙型に別名を付ける
color_t c = GREEN;
state_t s = BUSY;
int r1;

void main(void) {
    paint_t p = BLUE;
    enum Color e = c;            // 別名の列挙型と元の列挙型はどちらもintと同じ型
    r1 = p * 100 + e * 10 + s;   // 200 + 10 + 6 = 216
}
