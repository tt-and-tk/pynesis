// 引数式が関数呼び出しを含む呼び出し
// 内側の呼び出しは外側と同じ位置へ自分の引数を書くため，外側の引数は内側が終わるまでレジスタに保つ
int add(int a, int b) {
    return a + b;
}
int twice(int x) {
    return add(x, x);
}
int g;
void main(void) {
    g = add(1, add(2, 3));           // 同一関数の入れ子呼び出し (6)
    g = add(add(1, 2), add(3, 4));   // 両方の引数が呼び出し (10)
    g = add(twice(2), 5);            // 後ろの引数は呼び出しを含まない (9)
}
