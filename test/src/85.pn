// 関数ポインタ: 括弧を付けない関数名で関数の番地を取り，変数・引数・構造体メンバに入れて呼び出す
// 関数ポインタを通した呼び出しは，呼び出す関数の番地をレジスタに読み込んでから call rN で呼ぶ
// 引数の受け渡し・戻り値の受け取りは直接呼び出しと同じ規約に従い，
// 引数の中で関数を呼ぶ場合は呼び出す関数の番地を保持するレジスタも退避・復元する
struct Op {
    int (*apply)(int, int);
};

struct Op ops[2];
int r1;
int r2;
int r3;

int plus(int a, int b) {
    return a + b;
}

int minus(int a, int b) {
    return a - b;
}

int run(int (*f)(int, int), int x) {
    return f(x, 1);
}

void main(void) {
    int (*fp)(int, int) = plus;
    int i = 1;
    r1 = fp(2, 3);                // 5
    fp = minus;
    r2 = fp(fp(9, 4), 2);         // minus(minus(9, 4), 2) = 3
    ops[i].apply = plus;
    r3 = run(ops[i].apply, 7);    // plus(7, 1) = 8
    if (fp != nullptr) {
        r3 = r3 + run(minus, 1);  // 8 + minus(1, 1) = 8
    }
}
