// asm文の%=: asm文ごとに，プログラム全体で重ならない番号に置き換える
// - 1つのasm文の中では，何度書いても同じ番号になる
// - 番号はコンパイラの局所ラベル(.L0，.L1，…)と同じ連番から取る．%=を含まないasm文は番号を使わない
// - 退避領域を持つ関数でも，番号は連番のとおりになる
// (mainはifが.L0，1つ目のasm文が1，whileが.L2・.L3，3つ目のasm文が4を使い，hのasm文は5になる)
int g;
int f(int x) {
    return x;
}
int h(int x) {
    asm(".h%=:\n"
        "ne r0 r0 .h%=");
    return x + f(x);        // 呼び出しの前に左辺の値を退避する
}
void main(void) {
    if (g == 0) {
        g = 1;
    }
    asm(".a%=:\n"
        "eq r0 r0 .b%=\n"
        "ne r0 r0 .a%=\n"
        ".b%=:");
    asm("nop");
    while (g < 3) {
        g = g + 1;
    }
    asm(".c%=:\n"
        "ne r0 r0 .c%=");
    g = h(1);
}
