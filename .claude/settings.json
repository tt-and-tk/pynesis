{
  "extraKnownMarketplaces": {
    "for-pynthesis-skills": {
      "source": {
        "source": "github",
        "repo": "tt-and-tk/for-pynthesis-skills"
      }
    }
  },
  "enabledPlugins": {
    "for-pynthesis-skills@for-pynthesis-skills": true
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh issue close:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --delete:*)"
    ],
    "additionalDirectories": [
      "C:\\D\\program\\xilinx\\pynq-z2\\pc\\specification",
      "C:\\D\\program\\xilinx\\pynq-z2\\pc\\assembler"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-default-branch.sh\""
          }
        ]
      }
    ]
  }
}
